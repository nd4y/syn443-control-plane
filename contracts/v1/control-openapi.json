{
  "openapi": "3.1.0",
  "info": {
    "title": "SYN443 control catalog API",
    "version": "0.1.0",
    "description": "Distinct syn443-control-api audience, pinned mobile/web clients, DPoP body/key/token binding with durable replay rejection, live object-scoped ACL and signed fresh MFA. No browser bearer tokens, URL query, source-supplied signing authority or implicit broad publication. Mutations use stable requestId and expected revision; retry with a new DPoP proof and the same operation body. Source/profile secrets are omitted from inventory. M2/M3 remain incomplete until full acceptance."
  },
  "paths": {
    "/v1/control/action": {
      "post": {
        "operationId": "controlAction",
        "security": [
          {
            "adminDPoP": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Action"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Scoped result, never a secret mask"
          },
          "400": {
            "description": "Closed or bounded request rejected"
          },
          "403": {
            "description": "Identity, replay or live authority denied"
          },
          "409": {
            "description": "Revision, request identity or impact conflict"
          },
          "429": {
            "description": "Bounded admission or quota exceeded"
          },
          "503": {
            "description": "No durable success claimed while unavailable"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "adminDPoP": {
        "type": "http",
        "scheme": "DPoP",
        "description": "Separate administrative access token with scope syn443.control. DPoP req_hash covers exact JSON bytes and htu covers the configured origin and route. Nonce is absent; each jti is accepted once for its key/actor/time window."
      }
    },
