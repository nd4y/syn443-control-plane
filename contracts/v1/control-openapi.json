            "required": [
              "operation"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "operation": {
                "const": "replace"
              },
              "value": {}
            },
            "required": [
              "operation",
              "value"
            ]
          }
        ]
      },
