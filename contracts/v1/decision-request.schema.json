{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.syn443.invalid/v1/decision-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "context",
    "nowMs",
    "evidenceTtlMs",
    "intent",
    "metricGroup",
    "candidates"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "context": {
      "$ref": "#/$defs/context"
    },
    "nowMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "evidenceTtlMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 600000
    },
    "intent": {
      "enum": [
        "RU",
        "NON_RU",
        "INTERNAL"
      ]
    },
    "metricGroup": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "candidates": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "context",
          "allowed",
          "exitClass",
          "requiredHealthy",
          "optionalDegraded",
          "hardFailure",
          "observedAtMs",
          "samples",
          "failures",
          "trailingSuccesses",
          "bytesPerMinute",
          "handshakesPerMinute",
          "activeBackups",
          "latencyMs",
          "metricGroup"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          },
          "context": {
            "$ref": "#/$defs/context"
          },
          "allowed": {
            "type": "boolean"
          },
          "exitClass": {
            "enum": [
              "RU",
              "NON_RU",
              "INTERNAL"
            ]
          },
          "requiredHealthy": {
            "type": "boolean"
          },
          "optionalDegraded": {
            "type": "boolean"
          },
          "hardFailure": {
            "type": "boolean"
          },
          "observedAtMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "samples": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20
          },
          "failures": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20
          },
          "trailingSuccesses": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20
          },
          "bytesPerMinute": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              },
              {
                "type": "null"
              }
            ]
          },
          "handshakesPerMinute": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000
              },
              {
                "type": "null"
              }
            ]
          },
          "activeBackups": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 64
              },
              {
                "type": "null"
              }
            ]
          },
          "latencyMs": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 600000
              },
              {
                "type": "null"
              }
            ]
          },
          "metricGroup": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          }
        }
      }
    }
  },
  "$defs": {
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "networkEpoch",
        "activationGeneration",
        "configRevision",
        "algorithmRevision",
        "engineGeneration",
        "dependencyHash"
      ],
      "properties": {
        "networkEpoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "activationGeneration": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "configRevision": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "algorithmRevision": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "engineGeneration": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "dependencyHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
