  "components": {
    "securitySchemes": {
      "oidcDPoP": {
        "type": "http",
        "scheme": "DPoP",
        "description": "Keycloak RS256 access JWT with pinned issuer, syn443-api audience, syn443-android azp and cnf.jkt."
      },
      "deviceDPoP": {
        "type": "http",
        "scheme": "DPoP",
        "description": "Opaque ten-minute access token; refresh endpoint uses rotating key-bound refresh token."
      }
    },
    "schemas": {
      "PublicKey": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kty",
          "crv",
          "x",
          "y"
        ],
        "properties": {
          "kty": {
            "const": "EC"
          },
          "crv": {
            "const": "P-256"
          },
          "x": {
            "type": "string",
            "minLength": 43,
            "maxLength": 43,
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "y": {
            "type": "string",
            "minLength": 43,
            "maxLength": 43,
            "pattern": "^[A-Za-z0-9_-]{43}$"
          }
        }
      },
      "Enroll": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requestId",
          "key",
          "capabilities"
        ],
        "properties": {
          "requestId": {
            "type": "string",
            "minLength": 24,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]{24,128}$"
          },
          "key": {
            "$ref": "#/components/schemas/PublicKey"
          },
          "capabilities": {
            "type": "array",
            "minItems": 3,
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "allOf": [
              {
                "contains": {
                  "const": "engine-config.v1"
                }
              },
              {
                "contains": {
                  "const": "tun.lease.v1"
                }
              },
              {
                "contains": {
                  "const": "policy.keybound.v2"
                }
              }
            ]
          }
        }
      },
      "Mutation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requestId"
        ],
        "properties": {
          "requestId": {
            "type": "string",
            "minLength": 24,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]{24,128}$"
          }
        }
      },
      "Session": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "deviceId",
          "accessToken",
          "refreshToken",
          "accessUntilMs",
          "refreshUntilMs",
          "generation",
          "nonce"
        ],
        "properties": {
          "deviceId": {
            "type": "string",
            "minLength": 43,
            "maxLength": 43,
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "accessToken": {
            "type": "string",
            "minLength": 43,
            "maxLength": 43,
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "refreshToken": {
            "type": "string",
            "minLength": 43,
            "maxLength": 43,
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "accessUntilMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "refreshUntilMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "generation": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "nonce": {
            "type": "string",
            "minLength": 43,
            "maxLength": 43,
            "pattern": "^[A-Za-z0-9_-]{43}$"
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "enum": [
              "identity_invalid",
              "access_denied",
              "idempotency_conflict",
              "proof_replayed",
              "session_reuse",
              "provisioning_pending",
              "reauthentication_required",
              "use_dpop_nonce",
              "temporarily_unavailable"
            ]
          }
        }
      },
      "Cleanup": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requestId",
          "thumbprints"
        ],
        "properties": {
          "requestId": {
            "type": "string",
            "minLength": 24,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]{24,128}$"
          },
          "thumbprints": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 43,
              "maxLength": 43,
              "pattern": "^[A-Za-z0-9_-]{43}$"
            }
          }
        }
      }
    }
  },
  "x-syn443-limits": {
    "requestBodyBytes": 8192,
    "acceptedProofPastSeconds": 60,
    "acceptedProofFutureSeconds": 10,
    "proofReplaySeconds": 180,
    "idempotencyReplySeconds": 180,
    "accessSeconds": 600,
    "refreshFamilySeconds": 86400,
    "publicationSeconds": 3600,
    "activeDevicesPerAccountMaximum": 16,
    "activeIdentityChallengesPerAccount": 32
  },
  "x-syn443-storage": "PostgreSQL transactions, explicit owner/API/publisher roles, encrypted receipt/reply/publication, hashed opaque tokens, durable nonce/replay/time fence. POST requestId reuse requires identical raw payload hash. No secrets in errors or logs."
}
