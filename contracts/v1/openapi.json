{
  "openapi": "3.1.0",
  "info": {
    "title": "SYN443 M0 loopback preview",
    "version": "0.1.0",
    "description": "Development-only pure evaluator. No enrollment, production device API or network probes."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8080"
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Process is available; productionReady is always false",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "status",
                    "productionReady",
                    "contractVersion"
                  ],
                  "properties": {
                    "status": {
                      "const": "ok"
                    },
                    "productionReady": {
                      "const": false
                    },
                    "contractVersion": {
                      "const": "0.1.0"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/decision-preview": {
      "post": {
        "operationId": "previewDecision",
        "x-max-body-bytes": 1048576,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./decision-request.schema.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Selection, with null winner when no candidate is eligible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./decision-result.schema.json"
                }
              }
            }
          },
          "400": {
            "description": "invalid_request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "code"
                  ],
                  "properties": {
                    "code": {
                      "const": "invalid_request"
                    }
                  }
                }
              }
            }
          },
          "413": {
            "description": "request_too_large",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "code"
                  ],
                  "properties": {
                    "code": {
                      "const": "request_too_large"
                    }
                  }
                }
              }
            }
          },
          "415": {
            "description": "unsupported_media_type",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "code"
                  ],
                  "properties": {
                    "code": {
                      "const": "unsupported_media_type"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

