{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.example.invalid/overlay-credential.schema.json",
  "title": "SYN443 addressed overlay enrollment credential payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "audience",
    "address",
    "keyThumbprint",
    "reference",
    "version",
    "securityEpoch",
    "kind",
    "issuedAtMs",
    "notBeforeMs",
    "expiresMs",
    "value"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "audience": {
      "const": "syn443-overlay-credential"
    },
    "address": {
      "$ref": "#/$defs/address"
    },
    "keyThumbprint": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "reference": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "securityEpoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "kind": {
      "const": "netbird.setup-key"
    },
    "issuedAtMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "notBeforeMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "expiresMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "value": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{8}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{12}$"
    }
  },
  "$defs": {
    "address": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "serviceId",
        "ownerTag",
        "deviceId",
        "overlayId",
        "provider",
        "resourceId",
        "networkId",
        "identityEpoch",
        "managementURL"
      ],
      "properties": {
        "serviceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "ownerTag": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "deviceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,64}$"
        },
        "overlayId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "provider": {
          "const": "netbird"
        },
        "resourceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "networkId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "identityEpoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "managementURL": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^https://"
        }
      }
    }
  },
  "$comment": "The signature context, canonical encoding, digest pad bits, conservative time/lease bounds and authority equality are checked separately. This schema does not grant SDK enrollment or define HTTP delivery."
}
