{
  "realm": "syn443-test",
  "enabled": true,
  "displayName": "SYN443 Test",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "duplicateEmailsAllowed": false,
  "sslRequired": "external",
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "waitIncrementSeconds": 30,
  "maxFailureWaitSeconds": 900,
  "eventsEnabled": true,
  "eventsExpiration": 604800,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "passwordPolicy": "length(16) and notUsername",
  "attributes": {
    "syn443.owner": "syn443-test-operator",
    "syn443.purpose": "integration-test"
  },
  "roles": {
    "realm": [
      {
        "name": "syn443-user"
      },
      {
        "name": "syn443-admin"
      }
    ]
  },
  "clients": [
    {
      "clientId": "syn443-android",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "syn443://oauth/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "oauth2.device.authorization.grant.enabled": "false"
      }
    },
    {
      "clientId": "syn443-test-web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://127.0.0.1:17843/callback"
      ],
      "webOrigins": [
        "http://127.0.0.1:17843"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "oauth2.device.authorization.grant.enabled": "false"
      }
    }
  ]
}
